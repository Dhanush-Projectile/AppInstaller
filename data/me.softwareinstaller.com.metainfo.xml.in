<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>me.softwareinstaller.com</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Software Installer</name>
  <summary>Install DEB and RPM packages</summary>
  <description>
    <p>Software Installer lets you install DEB and RPM packages outside of your distribution's software center. Just choose a package file or drag and drop it onto the window, then confirm the install with your system authentication.</p>
  </description>

  <developer id="me.softwareinstaller.com">
    <name>Dhanush</name>
  </developer>

  <url type="homepage">https://github.com/Dhanush-Projectile/AppInstaller</url>
  <url type="vcs-browser">https://github.com/Dhanush-Projectile/AppInstaller</url>
  <url type="bugtracker">https://github.com/Dhanush-Projectile/AppInstaller/issues</url>

  <translation type="gettext">softwareinstaller</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">me.softwareinstaller.com.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Set a brand color in both light and dark variants to match the app icon -->
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-09-19">
      <description translate="no">
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

</component>
